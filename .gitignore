# Derived artefacts. Rebuildable from data/corpus/ and config.yaml.
data/index/
data/raw/
!data/raw/.gitkeep

# Model weights. Never commit these.
models/
*.gguf
*.onnx
*.safetensors
*.bin

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/

# Eval output
eval/reports/

# ---- ADTC 2026 competition ----
# Submission model: the evaluator downloads it fresh via download_model.sh.
# Required by the template rules: "No model weights in git."
model/
!model/.gitkeep

# Bake-off candidates, several GB.
models/bakeoff/

# Archived measurement runs: publish the RECORDS, never the bulk.
#
# REPORT.md tells a reader that every measurement has a run directory they can inspect.
# If nothing ships, that claim is true internally and unverifiable externally, which is
# the weakest position a provenance claim can be in. The records are a few hundred KB of
# JSON plus stale markers and small logs. The bulk is copied model weights, which are
# excluded by *.gguf above and would be several hundred MB.
#
# Not-for-quotation runs ship too, markers intact. A FIDELITY_STALE directory is evidence
# that we caught our own violation and retired the figures it produced; deleting it would
# publish a cleaner archive than the one we actually worked from.
runs/**
!runs/**/
!runs/**/*.json
!runs/**/*.log
!runs/**/*.stderr
# Marker files: FIDELITY_STALE.txt, VERDICT_STALE.txt and any successor. They are the
# record of a guard firing on our own results, so they ship with the runs they annotate.
!runs/**/*.txt
# Blind-scoring packs: the score sheet and the sealed mapping are the record that the
# behavioural ordering was made without knowing whose transcript was whose. Without them
# the published pack is three unlabelled transcripts and no evidence of the procedure.
# The seal is base64, so publishing it protects nothing and hides nothing that a
# determined reader could not already get; the blind is procedural, and the repository is
# private until the 23rd in any case.
!runs/**/*.md
!runs/**/*.b64

# Profiler output at the repo root, if run manually rather than through make profile.
submission.json
audit.json
verdict.json

# lm-eval dataset cache (build time, several hundred MB)
.cache/
